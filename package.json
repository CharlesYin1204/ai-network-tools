{
  "name": "xunfu-network",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack -H 0.0.0.0 -p 3050",
    "build": "next build --webpack",
    "start": "next start -H 0.0.0.0 -p 3050",
    "db:init": "node --env-file=.env.local scripts/init-db.mjs",
    "test:api": "TEST_BASE_URL=http://127.0.0.1:3050 node --env-file=.env.local scripts/test-api.mjs",
    "test:browser": "node scripts/test-browser.mjs",
    "db:backup": "node --env-file=.env.local scripts/backup-database.mjs",
    "db:migrate": "node --env-file=.env.local scripts/migrate-ui-contract.mjs && node --env-file=.env.local scripts/migrate-community.mjs",
    "test:workflows": "node --env-file=.env.local scripts/test-browser-workflows.mjs",
    "test:mobile": "node scripts/test-mobile-final.mjs",
    "test:contract": "node --env-file=.env.local scripts/test-contract.mjs"
  },
  "dependencies": {
    "next": "16.4.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "mysql2": "^3.15.3",
    "bcryptjs": "^3.0.3",
    "jose": "^6.1.0",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0"
  },
  "engines": {
    "node": ">=22"
  }
}
